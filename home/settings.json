{
  "model": "",
  "fallbackModel": [ "" ],
  "agent": "general",
  "language": "english",
  "cleanupPeriodDays": 60,
  "autoUpdatesChannel": "stable",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "feedbackSurveyRate": 0,
  "disableWorkflows": true,
  "workflowKeywordTriggerEnabled": false,
  "plansDirectory": "./.claude/plans",
  "theme": "dark-ansi",
  "tui": "default",
  "teammateMode": "in-process",
  "outputStyle": "Concise",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "autoMode": {
    "classifyAllShell": false
  },
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "permissions": {
    "allow": [
      "Bash(**)",
      "Read(**)",
      "Edit(**)",
      "Skill(**)",
      "Edit(~/Projects/**/.git/COMMIT_MESS)",
      "Edit(**/.git/COMMIT_MESS)",
      "Edit(**/.git/COMMIT_EDITMSG)",
      "Edit(**/AI.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/IDEA.md)",
      "Edit(**/SPEC.md)",
      "Edit(**/TODO.AI.md)",
      "Edit(**/TODO.md)",
      "Edit(**/PLAN.AI.md)",
      "Edit(**/PLAN.md)",
      "Edit(**/.env)",
      "Edit(**/app.env)",
      "Edit(**/default.env)",
      "Edit(**/.no_push)",
      "Edit(**/.dockerignore)",
      "Edit(**/.gitignore)",
      "Edit(**/.gitattributes)",
      "Edit(**/.editorconfig)",
      "Edit(**/.npmignore)",
      "Edit(**/.eslintignore)",
      "Edit(**/.prettierignore)",
      "Edit(**/settings.json)",
      "Edit(**/settings.local.json)",
      "WebSearch",
      "WebFetch(domain:google.com)",
      "WebFetch(domain:www.google.com)",
      "WebFetch(domain:duckduckgo.com)",
      "WebFetch(domain:www.duckduckgo.com)",
      "WebFetch(domain:html.duckduckgo.com)",
      "WebFetch(domain:scour.li)",
      "WebFetch(domain:www.scour.li)",
      "WebFetch(domain:bing.com)",
      "WebFetch(domain:www.bing.com)",
      "WebFetch(domain:kagi.com)",
      "WebFetch(domain:startpage.com)",
      "WebFetch(domain:www.startpage.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:gitlab.com)",
      "WebFetch(domain:www.gitlab.com)",
      "WebFetch(domain:docs.gitlab.com)",
      "WebFetch(domain:bitbucket.org)",
      "WebFetch(domain:www.bitbucket.org)",
      "WebFetch(domain:codeberg.org)",
      "WebFetch(domain:sr.ht)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:www.stackoverflow.com)",
      "WebFetch(domain:stackexchange.com)",
      "WebFetch(domain:serverfault.com)",
      "WebFetch(domain:superuser.com)",
      "WebFetch(domain:askubuntu.com)",
      "WebFetch(domain:unix.stackexchange.com)",
      "WebFetch(domain:security.stackexchange.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:python.org)",
      "WebFetch(domain:www.python.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:pkg.go.dev)",
      "WebFetch(domain:rust-lang.org)",
      "WebFetch(domain:www.rust-lang.org)",
      "WebFetch(domain:doc.rust-lang.org)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:www.nodejs.org)",
      "WebFetch(domain:man7.org)",
      "WebFetch(domain:www.man7.org)",
      "WebFetch(domain:linux.die.net)",
      "WebFetch(domain:explainshell.com)",
      "WebFetch(domain:shellcheck.net)",
      "WebFetch(domain:www.shellcheck.net)",
      "WebFetch(domain:regex101.com)",
      "WebFetch(domain:devdocs.io)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docker.com)",
      "WebFetch(domain:www.docker.com)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebFetch(domain:ghcr.io)",
      "WebFetch(domain:quay.io)",
      "WebFetch(domain:archlinux.org)",
      "WebFetch(domain:www.archlinux.org)",
      "WebFetch(domain:wiki.archlinux.org)",
      "WebFetch(domain:aur.archlinux.org)",
      "WebFetch(domain:ubuntu.com)",
      "WebFetch(domain:www.ubuntu.com)",
      "WebFetch(domain:help.ubuntu.com)",
      "WebFetch(domain:manpages.ubuntu.com)",
      "WebFetch(domain:debian.org)",
      "WebFetch(domain:www.debian.org)",
      "WebFetch(domain:wiki.debian.org)",
      "WebFetch(domain:manpages.debian.org)",
      "WebFetch(domain:fedoraproject.org)",
      "WebFetch(domain:docs.fedoraproject.org)",
      "WebFetch(domain:redhat.com)",
      "WebFetch(domain:www.redhat.com)",
      "WebFetch(domain:access.redhat.com)",
      "WebFetch(domain:almalinux.org)",
      "WebFetch(domain:wiki.almalinux.org)",
      "WebFetch(domain:rockylinux.org)",
      "WebFetch(domain:docs.rockylinux.org)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:linuxcontainers.org)",
      "WebFetch(domain:helm.sh)",
      "WebFetch(domain:aws.amazon.com)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:docs.microsoft.com)",
      "WebFetch(domain:digitalocean.com)",
      "WebFetch(domain:www.digitalocean.com)",
      "WebFetch(domain:nvd.nist.gov)",
      "WebFetch(domain:cve.mitre.org)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:www.owasp.org)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:wikipedia.org)",
      "WebFetch(domain:en.wikipedia.org)",
      "WebFetch(domain:www.wikipedia.org)",
      "WebFetch(domain:kernel.org)",
      "WebFetch(domain:www.kernel.org)",
      "WebFetch(domain:rfc-editor.org)",
      "WebFetch(domain:www.rfc-editor.org)",
      "WebFetch(domain:ietf.org)",
      "WebFetch(domain:www.ietf.org)",
      "WebFetch(domain:datatracker.ietf.org)",
      "WebFetch(domain:w3.org)",
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:news.ycombinator.com)",
      "WebFetch(domain:reddit.com)",
      "WebFetch(domain:www.reddit.com)",
      "WebFetch(domain:old.reddit.com)",
      "WebFetch(domain:lobste.rs)",
      "WebFetch(domain:casjay.cc)",
      "WebFetch(domain:dockersrc.us)"
    ],
    "additionalDirectories": [
      "~/Projects"
    ],
    "deny": [
      "Bash(git reset *)",
      "Bash(dd *)",
      "Bash(shred *)",
      "Bash(mkfs*)",
      "Bash(wipefs *)"
    ],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-compact.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/drift-guard-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-read-gitcommit.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-read-gitcommit.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/drift-guard-read.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-host.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-host-toolchain.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-docker-rm.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bound-shell-lifetime.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/zone-git-commit-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-subagent-commit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-force-push.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-history-rewrite.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-destructive-bypass.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bash-content-scan.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-gitcommit-shape.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-test-lint-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-commit-mess-coverage.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/enforce-doc-sync.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-read-gitcommit.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/validate-workflows.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-ai-attribution.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-secrets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-forbidden-files.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-todo-comments.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/comment-placement-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/spec-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-ai-attribution.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-secrets.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-forbidden-files.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-todo-comments.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/comment-placement-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/spec-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/spec-guard-mark.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/test-lint-mark.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/trailing-newline-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/trailing-newline-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-agent-mark.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "env": {
    "TMUX": "",
    "TMUX_PANE": "",
    "TERM_PROGRAM": "",
    "CLAUDE_CODE_DISABLE_MOUSE": "1",
    "COLORTERM": "truecolor",
    "CLAUDE_CODE_NO_FLICKER": "0",
    "MAX_THINKING_TOKENS": "1024",
    "MAX_MCP_OUTPUT_TOKENS": "2048",
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1"
  }
}
